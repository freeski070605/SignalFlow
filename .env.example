ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://api.alpaca.markets
ALPACA_DATA_FEED=iex
PRIMARY_MARKET=crypto
ACTIVE_EXCHANGE=coinbase
ENABLE_STOCKS_MODULE=true
ENABLE_CRYPTO_MODULE=true
ENABLE_FOREX_MODULE=false
COINBASE_API_KEY_NAME=
# Use one quoted line with literal \n separators, for example:
# COINBASE_API_PRIVATE_KEY="-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----"
COINBASE_API_PRIVATE_KEY=
COINBASE_API_BASE_URL=https://api.coinbase.com/api/v3/brokerage
COINBASE_PUBLIC_BASE_URL=https://api.exchange.coinbase.com
COINBASE_WS_URL=
CRYPTO_TRADING_ENABLED=true
CRYPTO_AUTO_EXECUTION=false
TRADING_MODE=live
AUTO_EXECUTION=false
MAX_DAILY_LOSS=1
MAX_TRADE_RISK=0.25
MAX_POSITION_NOTIONAL=5
MAX_OPEN_POSITIONS=1
ENABLE_CONTEXT_SYMBOL_TRADING=false
RISK_PER_TRADE_PERCENT=1
MAX_ACCOUNT_POSITION_PERCENT=25
MAX_DAILY_LOSS_PERCENT=5
MIN_NOTIONAL_ORDER=1
ALLOW_FRACTIONAL_ENTRIES=true
PROTECTION_MODE=auto
MONITORED_EXIT_INTERVAL_MS=5000
MONITORED_EXIT_MAX_STALE_SECONDS=20
ALLOW_MONITORED_FRACTIONAL_EXITS=true
SIGNAL_TTL_SECONDS=300
MAX_ENTRY_SLIPPAGE_PERCENT=0.5
MAX_EXTENSION_FROM_SIGNAL_PERCENT=1.0
REQUIRE_FRESH_REVIEW_BEFORE_APPROVAL=true
CRYPTO_RISK_PER_TRADE_PERCENT=1
CRYPTO_MAX_ACCOUNT_POSITION_PERCENT=25
CRYPTO_MAX_DAILY_LOSS_PERCENT=5
CRYPTO_MAX_OPEN_POSITIONS=1
CRYPTO_MIN_NOTIONAL_ORDER=1
CRYPTO_STOP_LOSS_PERCENT=1.5
CRYPTO_TAKE_PROFIT_PERCENT=3
CRYPTO_MAX_SPREAD_PERCENT=0.35
CRYPTO_MAX_SLIPPAGE_PERCENT=0.5
CRYPTO_COOLDOWN_AFTER_LOSS_MINUTES=15
CRYPTO_DAILY_TRADE_LIMIT=10
ALLOW_COUNTER_REGIME_TRADES=false
AUTO_CRYPTO_SCANNER=true
CRYPTO_SCANNER_INTERVAL_MS=60000
MIN_CRYPTO_PRICE=0.01
MAX_CRYPTO_PRICE=1000000
MIN_24H_VOLUME_USD=1000000
MIN_PERCENT_CHANGE_15M=0.15
MIN_PERCENT_CHANGE_1H=0.25
MIN_CANDLE_COUNT=50
EXCLUDE_STABLECOINS=true
MIN_PRICE=1
MAX_PRICE=500
MIN_DAILY_VOLUME=1000000
MIN_RELATIVE_VOLUME=1.2
MAX_SPREAD_PERCENT=0.5
MIN_PERCENT_CHANGE=0.5
EXCLUDE_OTC=true
REQUIRE_ACTIVE=true
REQUIRE_TRADABLE=true
PREFER_FRACTIONABLE=true
EXCLUDE_LEVERAGED_ETFS=true
MAX_RESULTS=50

PORT=4000
QUANT_SERVICE_URL=http://localhost:8000
MONGODB_URI=
MONGODB_DATABASE=signalflow
FRONTEND_ORIGIN=http://localhost:5173

# Frontend build-time values. In production, use the backend service host,
# not the Vercel frontend host. HTTPS frontends require WSS sockets.
VITE_API_URL=http://localhost:4000
VITE_WS_URL=ws://localhost:4000
VITE_LIVE_REFRESH_MS=5000
